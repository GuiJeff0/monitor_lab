# ==============================================================================
# Observability Lab & Ticket Booking System — Environment Variables Example
# ==============================================================================
# Copie este arquivo para .env e ajuste as variáveis de acordo com seu ambiente:
# cp .env.example .env

# ------------------------------------------------------------------------------
# 1. Configurações de Rede, Armazenamento e Tailscale
# ------------------------------------------------------------------------------
# Hostname e IP da máquina na rede Tailscale (obtenha via 'tailscale status' ou no painel da Tailscale)
TAILSCALE_HOSTNAME=sua-maquina.tailxxxx.ts.net
TAILSCALE_IP=100.x.y.z
DOCKER_NETWORK=observability-net

# Diretório base para persistência dos dados (Mimir TSDB, Loki logs, Tempo traces, Grafana)
# - Ambiente Local (Dev): DATA_DIR=./data
# - Servidor creedx66 (HDD 1TB): DATA_DIR=/mnt/dados/observability
DATA_DIR=./data

# ------------------------------------------------------------------------------
# 2. Versões das Imagens Docker — Infraestrutura & Observabilidade
# ------------------------------------------------------------------------------
TRAEFIK_VERSION=v3.7
GRAFANA_VERSION=13.1.1
MIMIR_VERSION=2.15.0
LOKI_VERSION=3.7.4
ALLOY_VERSION=v1.7.1
TEMPO_VERSION=2.6.1

# ------------------------------------------------------------------------------
# 3. Versões das Imagens Docker — Persistência Poliglota & Broker
# ------------------------------------------------------------------------------
POSTGRES_VERSION=16-alpine
MONGO_VERSION=7.0
ELASTICSEARCH_VERSION=8.17.0
RABBITMQ_VERSION=4.0-management-alpine
REDIS_VERSION=7.4-alpine

# ------------------------------------------------------------------------------
# 4. Credenciais Padrão (Ambiente Local / Lab)
# ------------------------------------------------------------------------------
# Grafana Web UI
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ticket_booking

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# MongoDB
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=example

# ------------------------------------------------------------------------------
# 5. Endpoints Padrão para Ingestão OpenTelemetry (OTel SDK)
# ------------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://mimir:8080/api/v1/push
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://loki:3100/otlp/v1/logs
